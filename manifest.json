{
  "manifest_version": 3,
  "minimum_chrome_version": "102",
  "name": "Sidenote for X",
  "short_name": "Sidenote",
  "version": "0.1.6",
  "description": "Leave private, local notes on X profiles and see them in your feed.",
  "permissions": ["storage"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "Sidenote for X",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/core.js", "src/storage.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
